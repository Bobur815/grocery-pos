// POSGRO - SQLite Schema for Electron POS Terminal
// This schema is for local offline-first operation
// Data syncs with the PostgreSQL server

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_DATABASE_URL")
}

// ==================== LOCAL STORE CONFIG ====================
// Terminal is assigned to ONE store - stored in local config

model LocalConfig {
  id         String   @id @default("config")
  storeId    String   @map("store_id")
  storeName  String   @map("store_name")
  terminalId String   @map("terminal_id")
  apiUrl     String   @map("api_url")
  storePin   String?  @map("store_pin") // 4-digit PIN (bcrypt hashed) for quick cashier login
  lastSync   DateTime @default(now()) @map("last_sync")

  @@map("local_config")
}

// ==================== USER MANAGEMENT ====================

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  password  String
  role      String   @default("USER") // ADMIN, USER
  nameUz    String   @map("name_uz")
  nameRu    String   @map("name_ru")
  active    Boolean  @default(true)
  storeId   String?  @map("store_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([storeId])
  @@map("users")
}

// ==================== PRODUCTS & INVENTORY ====================

model Category {
  id            Int       @id @default(autoincrement())
  nameUz        String    @map("name_uz")
  nameRu        String    @map("name_ru")
  active        Boolean   @default(true)
  mxikGroupCode String?   @map("mxik_group_code")
  products      Product[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id              Int      @id @default(autoincrement())
  barcode         String   @unique
  nameUz          String   @map("name_uz")
  nameRu          String   @map("name_ru")
  price           Decimal
  cost            Decimal?
  stock           Decimal  @default(0)
  minStock        Decimal  @default(0) @map("min_stock")
  unit            String   @default("шт")
  categoryId      Int      @map("category_id")
  category        Category @relation(fields: [categoryId], references: [id])
  supplierId      String?  @map("supplier_id")
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  productionDate  DateTime? @map("production_date")
  expiryDate      DateTime? @map("expiry_date")
  discountPercent       Decimal?  @default(0) @map("discount_percent")
  isOnPromotion         Boolean   @default(false) @map("is_on_promotion")
  pendingPrice          Decimal?  @map("pending_price")
  pendingPriceThreshold Decimal?  @map("pending_price_threshold")
  mxik                  String?   @map("mxik")
  // Authoritative Asl-Belgisi marking flag from tasnif `label` (1=marked, 0=plain).
  // Null = not yet checked → callers fall back to the isMarkedMxik(mxik) group heuristic.
  isMarked              Boolean?  @map("is_marked")
  active                Boolean   @default(true)


  // Weighted product fields
  // productType: REGULAR | BULK_WEIGHTED | PREPACKAGED
  productType   String  @default("REGULAR") @map("product_type")
  internalCode  String? @unique @map("internal_code") // 5-digit code for weighted products
  bulkQuantity  Decimal @default(0) @map("bulk_quantity")
  minSaleQty    Decimal @default(0) @map("min_sale_qty")
  maxSaleQty    Decimal @default(0) @map("max_sale_qty")

  storeProductCode Int? @map("store_product_code")

  // REGOS:VCR package (unit) code from MXIK — required for fiscalizing marked goods
  packageCode      String? @map("package_code")

  // VAT % registered for this product's MXIK (e.g. 0, 6 or 12). Null → use global regos_vcr_vat default
  vatRate          Float?  @map("vat_rate")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sales              SaleItem[]
  inventoryMovements InventoryArrival[]
  preWeighedItems    PreWeighedItem[]

  @@index([mxik]) // Fast MXIK lookup
  @@map("products")
}

// ==================== PRE-WEIGHED ITEMS ====================

model PreWeighedItem {
  id           String   @id @default(cuid())
  productId    Int      @map("product_id")
  product      Product  @relation(fields: [productId], references: [id])
  internalCode String   @map("internal_code")
  weight       Decimal  // in kg
  barcode      String   @unique
  pricePerKg   Decimal  @map("price_per_kg")
  totalPrice   Decimal  @map("total_price")
  // status: AVAILABLE | SOLD
  status       String   @default("AVAILABLE")
  createdAt    DateTime @default(now()) @map("created_at")
  soldAt       DateTime? @map("sold_at")
  saleId       String?  @map("sale_id")

  @@index([barcode])
  @@index([status])
  @@map("pre_weighed_items")
}

// ==================== SALES ====================

model Smena {
  id            String    @id @default(cuid())
  terminalId    String    @map("terminal_id")
  cashierId     String    @map("cashier_id")
  cashierName   String    @map("cashier_name")
  status        String    @default("OPEN")
  initialCash   Decimal   @map("initial_cash")
  finalCash     Decimal?  @map("final_cash")
  zReportNumber Int       @map("z_report_number")
  openedAt      DateTime  @default(now()) @map("opened_at")
  closedAt      DateTime? @map("closed_at")
  synced        Boolean   @default(false)
  regosZReportId Int?     @map("regos_z_report_id") // REGOS:VCR Z-report id for this shift
  sales         Sale[]
  movements     SmenaMovement[]

  @@index([terminalId, status])
  @@map("smenas")
}

model SmenaMovement {
  id        String   @id @default(cuid())
  smenaId   String   @map("smena_id")
  smena     Smena    @relation(fields: [smenaId], references: [id])
  type      String
  amount    Decimal
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([smenaId])
  @@map("smena_movements")
}

model Sale {
  id             String   @id @default(cuid())
  receiptNumber  String   @unique @map("receipt_number")
  totalAmount    Decimal  @map("total_amount")
  discountAmount Decimal  @default(0) @map("discount_amount")
  finalAmount    Decimal  @map("final_amount")
  paymentMethod  String   @map("payment_method")

  cashierId   String @map("cashier_id")
  cashierName String @map("cashier_name")
  terminalId  String @map("terminal_id")

  smenaId  String?  @map("smena_id")
  smena    Smena?   @relation(fields: [smenaId], references: [id])

  // REGOS:VCR fiscalization
  fiscalStatus    String?   @map("fiscal_status") // PENDING | FISCALIZED | FAILED | DISABLED
  fiscalAttempts  Int       @default(0) @map("fiscal_attempts")
  fiscalError     String?   @map("fiscal_error")
  regosReceiptId  String?   @map("regos_receipt_id")
  regosFiscalSign String?   @map("regos_fiscal_sign")
  regosQrCodeUrl  String?   @map("regos_qr_code_url")
  regosTerminalId String?   @map("regos_terminal_id")
  regosReceiptNo  String?   @map("regos_receipt_no")
  regosFiscalAt   DateTime? @map("regos_fiscal_at")
  regosLabels     String?   @map("regos_labels") // JSON [{barcode,label}] snapshot for marked goods
  refunded        Boolean   @default(false) // true once a fiscal full refund has been issued

  // Sync tracking
  synced   Boolean   @default(false)
  syncedAt DateTime? @map("synced_at")

  createdAt DateTime @default(now()) @map("created_at")

  items SaleItem[]

  @@index([synced])
  @@index([createdAt])
  @@index([smenaId])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String  @map("sale_id")
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId   Int     @map("product_id")
  product     Product @relation(fields: [productId], references: [id])

  productName String  @map("product_name")
  barcode     String
  quantity    Decimal
  unitPrice   Decimal @map("unit_price")
  subtotal    Decimal

  @@map("sale_items")
}

// ==================== SYSTEM SETTINGS ====================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ==================== INVENTORY MANAGEMENT ====================

model InventoryArrival {
  id        String   @id @default(cuid())
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])

  quantity  Decimal
  cost      Decimal
  totalCost Decimal  @map("total_cost")

  supplierId String?   @map("supplier_id")
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  notes String?

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_arrivals")
}

model Supplier {
  id      String  @id @default(cuid())
  nameUz  String  @map("name_uz")
  nameRu  String  @map("name_ru")
  phone   String?
  address String?
  active      Boolean @default(true)
  balance     Decimal @default(0) // Negative = we owe them, Positive = they owe us
  paymentType String  @default("IMMEDIATE") @map("payment_type") // IMMEDIATE | INSTALLMENT

  arrivals     InventoryArrival[]
  products     Product[]
  transactions SupplierTransaction[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("suppliers")
}

// ==================== SUPPLIER TRANSACTIONS ====================
// SupplierTransactionType: PURCHASE, PAYMENT, RETURN, ADVANCE, ADJUSTMENT
// SupplierPaymentMethod: CASH, CARD, BANK_TRANSFER, INSTALLMENT, ONE_TO_ONE

model SupplierTransaction {
  id         String   @id @default(cuid())
  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  type          String  // PURCHASE, PAYMENT, RETURN, ADVANCE, ADJUSTMENT
  paymentMethod String  @map("payment_method") // CASH, CARD, BANK_TRANSFER, INSTALLMENT, ONE_TO_ONE
  amount        Decimal // Positive = reduces our debt, Negative = increases our debt
  description   String?

  // Reference to related entity (e.g., InventoryArrival)
  referenceId   String? @map("reference_id")
  referenceType String? @map("reference_type")

  dueDate   DateTime? @map("due_date")
  paidAt    DateTime? @map("paid_at")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([supplierId])
  @@index([type])
  @@index([createdAt])
  @@map("supplier_transactions")
}

// ==================== MARKING CODES (Group 022 unique QR tracking) ====================

model SoldMarkingCode {
  id             String   @id @default(cuid())
  code           String   @unique
  productBarcode String?  @map("product_barcode")
  terminalId     String   @map("terminal_id")
  soldAt         DateTime @default(now()) @map("sold_at")
  synced         Boolean  @default(false)

  @@map("sold_marking_codes")
}

// Marking codes of sold group-022 products that were still IN circulation at sale time.
// Captured because there is no REGOS:VCR to fiscalize them yet; kept here (and synced to
// the VPS) so they can later be sent to a VCR to be taken out of circulation.
// `fiscalized` is reserved for that future step.
model PendingMarkingCode {
  id                String    @id @default(cuid())
  code              String    @unique
  productBarcode    String?   @map("product_barcode")
  saleId            String?   @map("sale_id")
  terminalId        String    @map("terminal_id")
  circulationStatus String?   @map("circulation_status") // raw asl-belgisi status (or null when unverified)
  fiscalized        Boolean   @default(false)
  synced            Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("pending_marking_codes")
}

// ==================== SYNC QUEUE ====================
// Track what needs to be synced to server

model SyncQueue {
  id        String   @id @default(cuid())
  entity    String   // "sale", "product_stock_update"
  entityId  String   @map("entity_id")
  action    String   // "create", "update", "delete"
  payload   String   // JSON data
  attempts  Int      @default(0)
  lastError String?  @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity])
  @@map("sync_queue")
}
